rce_path":"fixture_lighthouse_manual.md","supporting_intents":["I1"],"supporting_queries":["Q1"],"text":"During a storm the keeper stays in the lantern room. The fog signal sounds every 30 seconds while visibility is below 2 kilometres.","token_count":23},{"alternates":[],"best_rank_by_intent":{"I1":2,"I2":5},"char_end":471,"char_start":0,"chunk_id":"fixture_observatory_notes§1#1","citation":"fixture_observatory_notes §1","conflict_ids":["X1"],"document_id":"fixture_observatory_notes","evidence_id":"fixture_observatory_notes§1#1","fused_score":0.016129,"hits":[{"bm25_rank":null,"dense_rank":2,"intent_id":"I1","query_id":"Q1","rank":2,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.016129032258064516,"score":0.016129032258064516,"stale":false},{"bm25_rank":null,"dense_rank":5,"intent_id":"I2","query_id":"Q2","rank":5,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015384615384615385,"score":0.015384615384615385,"stale":false}],"intent_relevance":{},"label":"E2","section_id":"1","section_title":"fixture observatory notes","selected_for":["I1"],"source_path":"fixture_observatory_notes.txt","supporting_intents":["I1","I2"],"supporting_queries":["Q1","Q2"],"text":"TEST FIXTURE ONLY. Synthetic text written for software tests; it is not part of any real corpus.\n\nThe fixture observatory opens its dome only when the wind speed is below 25 kilometres per hour. Observers log the dome status every hour.\n\nThe main telescope is recalibrated on the first night of every month. Calibration takes about ninety minutes and is recorded in the calibration journal.\n\nVisitors are welcome on Fridays. Visitors may not touch the telescope controls.","token_count":77},{"alternates":[],"best_rank_by_intent":{"I1":3},"char_end":770,"char_start":604,"chunk_id":"fixture_lighthouse_manual§2#1","citation":"fixture_lighthouse_manual §2","conflict_ids":[],"document_id":"fixture_lighthouse_manual","evidence_id":"fixture_lighthouse_manual§2#1","fused_score":0.015873,"hits":[{"bm25_rank":null,"dense_rank":3,"intent_id":"I1","query_id":"Q1","rank":3,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015873015873015872,"score":0.015873015873015872,"stale":false}],"intent_relevance":{},"label":"E3","section_id":"2","section_title":"Logbook Rules","selected_for":["I1"],"source_path":"fixture_lighthouse_manual.md","supporting_intents":["I1"],"supporting_queries":["Q1"],"text":"Every watch must be logged with:\n\n- the time the watch started\n- the weather observed\n- any vessel sighted\n\nEntries are written in permanent ink and are never erased.","token_count":27},{"alternates":[],"best_rank_by_intent":{"I1":5},"char_end":288,"char_start":158,"chunk_id":"fixture_lighthouse_manual§1#1","citation":"fixture_lighthouse_manual §1","conflict_ids":[],"document_id":"fixture_lighthouse_manual","evidence_id":"fixture_lighthouse_manual§1#1","fused_score":0.015385,"hits":[{"bm25_rank":null,"dense_rank":5,"intent_id":"I1","query_id":"Q1","rank":5,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015384615384615385,"score":0.015384615384615385,"stale":false}],"intent_relevance":{},"label":"E4","section_id":"1","section_title":"Lamp Maintenance","selected_for":["I1"],"source_path":"fixture_lighthouse_manual.md","supporting_intents":["I1"],"supporting_queries":["Q1"],"text":"The lamp of the fixture lighthouse must be cleaned every evening before sunset. Keepers record each cleaning in the lamp register.","token_count":21},{"alternates":[],"best_rank_by_intent":{"I2":1},"char_end":582,"char_start":480,"chunk_id":"fixture_lighthouse_manual§1.2#1","citation":"fixture_lighthouse_manual §1.2","conflict_ids":[],"document_id":"fixture_lighthouse_manual","evidence_id":"fixture_lighthouse_manual§1.2#1","fused_score":0.032787,"hits":[{"bm25_rank":1,"dense_rank":1,"intent_id":"I2","query_id":"Q2","rank":1,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.03278688524590164,"score":0.03278688524590164,"stale":