firms the stack height before moving. Fruit picked after sunset is recorded separately. Late fruit is stored in the cool room until the next morning.","token_count":85},{"alternates":[],"best_rank_by_intent":{"I1":4,"I2":3},"char_end":656,"char_start":564,"chunk_id":"Doc_07§2.1#1","citation":"Doc_07 §2.1","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§2.1#1","fused_score":0.015873,"hits":[{"bm25_rank":null,"dense_rank":4,"intent_id":"I1","query_id":"Q1","rank":4,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015625,"score":0.015625,"stale":false},{"bm25_rank":null,"dense_rank":3,"intent_id":"I2","query_id":"Q3","rank":3,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015873015873015872,"score":0.015873015873015872,"stale":false}],"intent_relevance":{},"label":"E5","section_id":"2.1","section_title":"Ladder Safety","selected_for":["I2"],"source_path":"Doc_07_fixture_orchard.txt","supporting_intents":["I1","I2"],"supporting_queries":["Q1","Q3"],"text":"Ladders are permitted in the orchard only when a second worker holds the base of the ladder.","token_count":17},{"alternates":[],"best_rank_by_intent":{"I2":5},"char_end":1398,"char_start":1276,"chunk_id":"Doc_07§4#1","citation":"Doc_07 §4","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§4#1","fused_score":0.015385,"hits":[{"bm25_rank":null,"dense_rank":5,"intent_id":"I2","query_id":"Q3","rank":5,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015384615384615385,"score":0.015384615384615385,"stale":false}],"intent_relevance":{},"label":"E6","section_id":"4","section_title":"Tool Shed","selected_for":["I2"],"source_path":"Doc_07_fixture_orchard.txt","supporting_intents":["I2"],"supporting_queries":["Q3"],"text":"Before leaving the shed, each worker must:\n1. Clean the blades.\n2. Hang every tool on its hook.\n3. Sign the tool register.","token_count":23}],"per_intent":[{"best_rank":1,"candidates":5,"covered":true,"evidence_ids":["Doc_07