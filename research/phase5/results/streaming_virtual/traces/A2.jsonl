45,"chunk_id":"Doc_07§1#1","citation":"Doc_07 §1","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§1#1","fused_score":0.032787,"hits":[{"bm25_rank":1,"dense_rank":1,"intent_id":"I1","query_id":"Q1","rank":1,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.03278688524590164,"score":0.03278688524590164,"stale":false}],"intent_relevance":{},"label":"E1","section_id":"1","section_title":"Planting Schedule","selected_for":["I1"],"source_path":"Doc_07_fixture_orchard.txt","supporting_intents":["I1"],"supporting_queries":["Q1"],"text":"Saplings in the fixture orchard are planted between the third and fifth week of the planting season. Each sapling receives 12 litres of water on the day it is planted.\n\nApproved sapling varieties:\n\n1. Red Fixture Apple\n\n2. Golden Fixture Pear\n\n3. Blue Fixture Plum","token_count":45},{"alternates":[],"best_rank_by_intent":{"I1":2,"I2":2},"char_end":543,"char_start":423,"chunk_id":"Doc_07§2#1","citation":"Doc_07 §2","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§2#1","fused_score":0.032258,"hits":[{"bm25_rank":null,"dense_rank":2,"intent_id":"I1","query_id":"Q1","rank":2,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.016129032258064516,"score":0.016129032258064516,"stale":false},{"bm25_rank":2,"dense_rank":2,"intent_id":"I2","query_id":"Q3","rank":2,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.03225806451612903,"score":0.03225806451612903,"stale":false}],"intent_relevance":{},"label":"E2","section_id":"2","section_title":"Pruning","selected_for":["I1","I2"],"source_path":"Doc_07_fixture_orchard.txt","supporting_intents":["I1","I2"],"supporting_queries":["Q1","Q3"],"text":"Pruning happens once per year after the last frost. Branches thicker than a thumb are cut with a saw, never with shears.","token_count":22},{"alternates":[],"best_rank_by_intent":{"I1":3,"I2":4},"char_end":767,"char_start":678,"chunk_id":"Doc_07§2.2#1","citation":"Doc_07 §2.2","conf