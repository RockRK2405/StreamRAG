ker may fill at most 40 crates per shift. Damaged fruit is placed in the compost bin, not in the crates. The harvest supervisor checks the crate count at the end of every shift. Crates are stacked no more than five high. Stacks taller than five crates must be split before the cart leaves the row. The cart driver confirms the stack height before moving. Fruit picked after sunset is recorded separately. Late fruit is stored in the cool room until the next morning.","token_count":85},{"alternates":[],"best_rank_by_intent":{"I1":2,"I2":4},"char_end":767,"char_start":678,"chunk_id":"Doc_07§2.2#1","citation":"Doc_07 §2.2","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§2.2#1","fused_score":0.016129,"hits":[{"bm25_rank":null,"dense_rank":2,"intent_id":"I1","query_id":"Q1","rank":2,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.016129032258064516,"score":0.016129032258064516,"stale":false},{"bm25_rank":null,"dense_rank":4,"intent_id":"I2","query_id":"Q2","rank":4,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015625,"score":0.015625,"stale":false}],"intent_relevance":{},"label":"E2","section_id":"2.2","section_title":"Ladder Storage","selected_for":["I1"],"source_path":"Doc_07_fixture_orchard.txt","supporting_intents":["I1","I2"],"supporting_queries":["Q1","Q2"],"text":"Ladders are not permitted in the orchard overnight and must be returned to the tool shed.","token_count":16},{"alternates":[],"best_rank_by_intent":{"I1":3,"I2":3},"char_end":656,"char_start":564,"chunk_id":"Doc_07§2.1#1","citation":"Doc_07 §2.1","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§2.1#1","fused_score":0.015873,"hits":[{"bm25_rank":null,"dense_rank":3,"intent_id":"I1","query_id":"Q1","rank":3,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015873015873015872,"score":0.015873015873015872,"stale":false},{"bm25_rank":null,"dense_rank":3,"intent_id":"I2","query_id":"Q2","rank":3,"rerank_score":null,"retrieval_method