ol room until the next morning.","token_count":85},{"alternates":[],"best_rank_by_intent":{"I2":2},"char_end":471,"char_start":0,"chunk_id":"fixture_observatory_notes§1#1","citation":"fixture_observatory_notes §1","conflict_ids":["X1"],"document_id":"fixture_observatory_notes","evidence_id":"fixture_observatory_notes§1#1","fused_score":0.030798,"hits":[{"bm25_rank":3,"dense_rank":7,"intent_id":"I2","query_id":"Q2","rank":2,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.030798389007344232,"score":0.030798389007344232,"stale":false}],"intent_relevance":{},"label":"E5","section_id":"1","section_title":"fixture observatory notes","selected_for":["I2"],"source_path":"fixture_observatory_notes.txt","supporting_intents":["I2"],"supporting_queries":["Q2"],"text":"TEST FIXTURE ONLY. Synthetic text written for software tests; it is not part of any real corpus.\n\nThe fixture observatory opens its dome only when the wind speed is below 25 kilometres per hour. Observers log the dome status every hour.\n\nThe main telescope is recalibrated on the first night of every month. Calibration takes about ninety minutes and is recorded in the calibration journal.\n\nVisitors are welcome on Fridays. Visitors may not touch the telescope controls.","token_count":77},{"alternates":[],"best_rank_by_intent":{"I2":4,"I3":4},"char_end":767,"char_start":678,"chunk_id":"Doc_07§2.2#1","citation":"Doc_07 §2.2","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§2.2#1","fused_score":0.03125,"hits":[{"bm25_rank":null,"dense_rank":2,"intent_id":"I2","query_id":"Q2","rank":4,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.016129032258064516,"score":0.016129032258064516,"stale":false},{"bm25_rank":4,"dense_rank":4,"intent_id":"I3","query_id":"Q3","rank":4,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.03125,"score":0.03125,"stale":false}],"intent_relevance":{},"label":"E6","section_id":"2.2","section_title":"Ladder Storage","selected_for":["I2"],"source_path":"Doc_07_fixture_orchard.txt","supporting_intents":["I2","I3"],"supporting_queries":["Q2","Q3"],"text":"Ladders are not permitted in the orchard overnight and must be returned to the tool shed.","token_count":16},{"alternates":[],"best_rank_by_intent":{"I2":5},"char_end":925,"char_start":794,"chunk_id":"fixture_lighthouse_manual§3#1","citation":"fixture_lighthouse_manual §3","conflict_ids":["X1"],"document_id":"fixture_lighthouse_manual","evidence_id":"fixture_lighthouse_manual§3#1","fused_score":0.015873,"hits":[{"bm25_rank":null,"dense_rank":3,"intent_id":"I2","query_id":"Q2","rank":5,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015873015873015872,"score":0.015873015873015872,"stale":false}],"intent_relevance":{},"label":"E7","section_id":"3","section_title":"Storm Procedure","selected_for":["I2"],"source_path":"fixture_lighthouse_manual.md","supporting_intents":["I2"],"supporting_queries":["Q2"],"text":"During a storm the keeper stays in the lantern room. The fog signal sounds every 30 seconds while visibility is below 2 kilometres.","token_count":23},{"alternates":[],"best_rank_by_intent":{"I1":5,"I3":3},"char_end":656,"char_start":564,"chunk_id":"Doc_07§2.1#1","citation":"Doc_07 §2.1","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§2.1#1","fused_score":0.031258,"hits":[{"bm25_rank":null,"dense_rank":5,"intent_id":"I1","query_id":"Q1","rank":5,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015384615384615385,"score":0.015384615384615385,"stale":false},{"bm25_rank":3,"dense_rank":5,"intent_id":"I3","query_id":"Q3","rank":3,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.03125763125763126,"score":0.03125763125763126,"stale":false}],"intent_relevance":{},"label":"E8","section_id":"2.1","section_title":"Ladder Safety","selected_for":["I3"],"source_path":"Doc_07_fixture_orchard.txt","supporting_intents":["I1","I3"],"supporting_queries":["Q1","Q3"],"text":"Ladders are permit