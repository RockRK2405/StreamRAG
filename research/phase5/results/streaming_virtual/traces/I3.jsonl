],"unified_evidence":{"conflicts":[],"dedup":{"cross_intent_duplicates":0,"duplicate_items":0,"input_hits":5,"items":5,"near_duplicates_merged":0,"unique_chunks":5},"intent_set_version":2,"items":[{"alternates":[],"best_rank_by_intent":{"I1":1},"char_end":409,"char_start":145,"chunk_id":"Doc_07§1#1","citation":"Doc_07 §1","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§1#1","fused_score":0.032787,"hits":[{"bm25_rank":1,"dense_rank":1,"intent_id":"I1","query_id":"Q2","rank":1,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.03278688524590164,"score":0.03278688524590164,"stale":false}],"intent_relevance":{},"label":"E1","section_id":"1","section_title":"Planting Schedule","selected_for":["I1"],"source_path":"Doc_07_fixture_orchard.txt","supporting_intents":["I1"],"supporting_queries":["Q2"],"text":"Saplings in the fixture orchard are planted between the third and fifth week of the planting season. Each sapling receives 12 litres of water on the day it is planted.\n\nApproved sapling varieties:\n\n1. Red Fixture Apple\n\n2. Golden Fixture Pear\n\n3. Blue Fixture Plum","token_count":45},{"alternates":[],"best_rank_by_intent":{"I1":2},"char_end":543,"char_start":423,"chunk_id":"Doc_07§2#1","citation":"Doc_07 §2","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§2#1","fused_score":0.016129,"hits":[{"bm25_rank":null,"dense_rank":2,"intent_id":"I1","query_id":"Q2","rank":2,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.016129032258064516,"score":0.016129032258064516,"stale":false}],"intent_relevance":{},"label":"E2","section_id":"2","section_title":"Pruning","selected_for":["I1"],"source_path":"Doc_07_fixture_orchard.txt","supporting_intents":["I1"],"supporting_queries":["Q2"],"text":"Pruning happens once per year after the last frost. Branches thicker than a thumb are cut with a saw, never with shears.","token_count":22},{"alternates":[],"best_rank_by_intent":{"I1":3},"char_end":1260,"char_start":789,"chunk_id":"Doc_07§3#1","citation":"Doc_07 §3","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§3#1","fused_score":0.015873,"hits":[{"bm25_rank":null,"dense_rank":3,"intent_id":"I1","query_id":"Q2","rank":3,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015873015873015872,"score":0.015873015873015872,"stale":false}],"intent_relevance":{},"label":"E3","section_id":"3","section_title":"Harvest Limits","selected_for":["I1"],"source_path":"Doc_07_fixture_orchard.txt","supporting_intents":["I1"],"supporting_queries":["Q2"],"text":"A picker may fill at most 40 crates per shift. Damaged fruit is placed in the compost bin, not in the crates. The harvest supervisor checks the crate count at the end of every shift. Crates are stacked no more than five high. Stacks taller than five crates must be split before the cart leaves the row. The cart driver confirms the stack height before moving. Fruit picked after sunset is recorded separately. Late fruit is stored in the cool room until the next morning.","token_count":85},{"alternates":[],"best_rank_by_intent":{"I1":4},"char_end":1398,"char_start":1276,"chunk_id":"Doc_07§4#1","citation":"Doc_07 §4","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§4#1","fused_score":0.015625,"hits":[{"bm25_rank":null,"dense_rank":4,"intent_id":"I1","query_id":"Q2","rank":4,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015625,"score":0.015625,"stale":false}],"intent_relevance":{},"label":"E4","section_id":"4","section_title":"Tool Shed","selected_for":["I1"],"source_path":"Doc_07_fixture_orchard.txt","supporting_intents":["I1"],"supporting_queries":["Q2"],"text":"Before leaving the shed, each worker must:\n1. Clean the blades.\n2. Hang every tool on its hook.\n3. Sign the tool register.","token_count":23},{"alternates":[],"best_rank_by_intent":{"I1":5},"char_end":121,"char_start":0,"chunk_id":"Doc_07§0#1","citation":"Doc_07 §0","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§0#