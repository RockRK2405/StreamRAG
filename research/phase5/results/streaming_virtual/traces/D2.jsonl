ual§2#1","citation":"fixture_lighthouse_manual §2","conflict_ids":[],"document_id":"fixture_lighthouse_manual","evidence_id":"fixture_lighthouse_manual§2#1","fused_score":0.031746,"hits":[{"bm25_rank":3,"dense_rank":3,"intent_id":"I1","query_id":"Q2","rank":3,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.031746031746031744,"score":0.031746031746031744,"stale":false}],"intent_relevance":{},"label":"E3","section_id":"2","section_title":"Logbook Rules","selected_for":["I1"],"source_path":"fixture_lighthouse_manual.md","supporting_intents":["I1"],"supporting_queries":["Q2"],"text":"Every watch must be logged with:\n\n- the time the watch started\n- the weather observed\n- any vessel sighted\n\nEntries are written in permanent ink and are never erased.","token_count":27},{"alternates":[],"best_rank_by_intent":{"I1":4},"char_end":1398,"char_start":1276,"chunk_id":"Doc_07§4#1","citation":"Doc_07 §4","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§4#1","fused_score":0.015625,"hits":[{"bm25_rank":null,"dense_rank":4,"intent_id":"I1","query_id":"Q2","rank":4,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015625,"score":0.015625,"stale":false}],"intent_relevance":{},"label":"E4","section_id":"4","section_title":"Tool Shed","selected_for":["I1"],"source_path":"Doc_07_fixture_orchard.txt","supporting_intents":["I1"],"supporting_queries":["Q2"],"text":"Before leaving the shed, each worker must:\n1. Clean the blades.\n2. Hang every tool on its hook.\n3. Sign the tool register.","token_count":23},{"alternates":[],"best_rank_by_intent":{"I1":5},"char_end":1260,"char_start":789,"chunk_id":"Doc_07§3#1","citation":"Doc_07 §3","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§3#1","fused_score":0.015385,"hits":[{"bm25_rank":null,"dense_rank":5,"intent_id":"I1","query_id":"Q2","rank":5,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015384615384615385,"score":0.015384615384615385,"stale":false}],"intent_relevance":{},"label":"E5","section_id":"3","section_title":"Harvest Limits","selected_for":["I1"],"source_path":"Doc_07_fixture_orchard.txt","supporting_intents":["I1"],"supporting_queries":["Q2"],"text":"A picker may fill at most 40 crates per shift. Damaged fruit is placed in the compost bin, not in the crates. The harvest supervisor checks the crate count at the end of every shift. Crates are stacked no more than five high. Stacks taller than five crates must be split before the cart leaves the row. The cart driver confirms the stack height before moving. Fruit picked after sunset is recorded separately. Late fruit is stored in the cool room until the next morning.","token_count":85}],"per_intent":[{"best_rank":1,"candidates":5,"covered":true,"evidence_ids":["Doc_07§2.2#1","Doc_07§2.1#1","fixture_lighthouse_manual§2#1","Doc_07§4#1","Doc_07§3#1"],"intent_id":"I1","labels":["E1","E2","E3","E4","E5"],"query_id":"Q2","status":"ok"}],"relations":[],"rerank":"none","session_id":"mi-D2","strategy":"intent_aware","token_count":168,"top_k":8,"unified_set_id":"ues-7bb614ef1434","utterance_id":"u1","warnings":[]},"wall":{"decompose_ms_total":1.1401,"fusion_timings_ms":{"conflicts":0.0114,"dedup":0.0113,"select":0.0056,"total":0.0653}}},"query_id":null,"schema_version":"1.0","seq":31,"session_id":"mi-D2","t_session_ms":3382.9,"t_stream_s":3.3829,"t_wall_ms":9.144,"type":"TURN_COMPLETED","utterance_id":"u1"}
