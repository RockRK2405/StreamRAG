nthetic text written for software tests; it is not part of any real corpus.\n\nThe fixture observatory opens its dome only when the wind speed is below 25 kilometres per hour. Observers log the dome status every hour.\n\nThe main telescope is recalibrated on the first night of every month. Calibration takes about ninety minutes and is recorded in the calibration journal.\n\nVisitors are welcome on Fridays. Visitors may not touch the telescope controls.","token_count":77},{"alternates":[],"best_rank_by_intent":{"I1":3},"char_end":770,"char_start":604,"chunk_id":"fixture_lighthouse_manual§2#1","citation":"fixture_lighthouse_manual §2","conflict_ids":[],"document_id":"fixture_lighthouse_manual","evidence_id":"fixture_lighthouse_manual§2#1","fused_score":0.015873,"hits":[{"bm25_rank":null,"dense_rank":3,"intent_id":"I1","query_id":"Q2","rank":3,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015873015873015872,"score":0.015873015873015872,"stale":false}],"intent_relevance":{},"label":"E3","section_id":"2","section_title":"Logbook Rules","selected_for":["I1"],"source_path":"fixture_lighthouse_manual.md","supporting_intents":["I1"],"supporting_queries":["Q2"],"text":"Every watch must be logged with:\n\n- the time the watch started\n- the weather observed\n- any vessel sighted\n\nEntries are written in permanent ink and are never erased.","token_count":27},{"alternates":[],"best_rank_by_intent":{"I1":4},"char_end":133,"char_start":37,"chunk_id":"fixture_lighthouse_manual§0#1","citation":"fixture_lighthouse_manual §0","conflict_ids":[],"document_id":"fixture_lighthouse_manual","evidence_id":"fixture_lighthouse_manual§0#1","fused_score":0.015625,"hits":[{"bm25_rank":null,"dense_rank":4,"intent_id":"I1","query_id":"Q2","rank":4,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015625,"score":0.015625,"stale":false}],"intent_relevance":{},"label":"E4","section_id":"0","section_title":"Fixture Lighthouse Keeping Manual","selected_for":["I1"],"s