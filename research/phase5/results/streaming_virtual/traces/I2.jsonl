ore":0.032258,"hits":[{"bm25_rank":2,"dense_rank":2,"intent_id":"I1","query_id":"Q3","rank":2,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.03225806451612903,"score":0.03225806451612903,"stale":false}],"intent_relevance":{},"label":"E2","section_id":"2.1","section_title":"Ladder Safety","selected_for":["I1"],"source_path":"Doc_07_fixture_orchard.txt","supporting_intents":["I1"],"supporting_queries":["Q3"],"text":"Ladders are permitted in the orchard only when a second worker holds the base of the ladder.","token_count":17},{"alternates":[],"best_rank_by_intent":{"I1":3},"char_end":1260,"char_start":789,"chunk_id":"Doc_07§3#1","citation":"Doc_07 §3","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§3#1","fused_score":0.031746,"hits":[{"bm25_rank":3,"dense_rank":3,"intent_id":"I1","query_id":"Q3","rank":3,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.031746031746031744,"score":0.031746031746031744,"stale":false}],"intent_relevance":{},"label":"E3","section_id":"3","section_title":"Harvest Limits","selected_for":["I1"],"source_path":"Doc_07_fixture_orchard.txt","supporting_intents":["I1"],"supporting_queries":["Q3"],"text":"A picker may fill at most 40 crates per shift. Damaged fruit is placed in the compost bin, not in the crates. The harvest supervisor checks the crate count at the end of every shift. Crates are stacked no more than five high. Stacks taller than five crates must be split before the cart leaves the row. The cart driver confirms the stack height before moving. Fruit picked after sunset is recorded separately. Late fruit is stored in the cool room until the next morning.","token_count":85},{"alternates":[],"best_rank_by_intent":{"I1":4},"char_end":409,"char_start":145,"chunk_id":"Doc_07§1#1","citation":"Doc_07 §1","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§1#1","fused_score":0.030536,"hits":[{"bm25_rank":6,"dense_rank":5,"intent_id":"I1","query_id":"Q3","rank":4,"rerank_score":null