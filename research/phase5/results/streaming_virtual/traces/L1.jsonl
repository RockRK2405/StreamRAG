 cool room until the next morning.","token_count":85},{"alternates":[],"best_rank_by_intent":{"I2":2},"char_end":1398,"char_start":1276,"chunk_id":"Doc_07§4#1","citation":"Doc_07 §4","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§4#1","fused_score":0.016129,"hits":[{"bm25_rank":null,"dense_rank":2,"intent_id":"I2","query_id":"Q3","rank":2,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.016129032258064516,"score":0.016129032258064516,"stale":false}],"intent_relevance":{},"label":"E2","section_id":"4","section_title":"Tool Shed","selected_for":["I2"],"source_path":"Doc_07_fixture_orchard.txt","supporting_intents":["I2"],"supporting_queries":["Q3"],"text":"Before leaving the shed, each worker must:\n1. Clean the blades.\n2. Hang every tool on its hook.\n3. Sign the tool register.","token_count":23},{"alternates":[],"best_rank_by_intent":{"I2":3},"char_end":767,"char_start":678,"chunk_id":"Doc_07§2.2#1","citation":"Doc_07 §2.2","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§2.2#1","fused_score":0.015873,"hits":[{"bm25_rank":null,"dense_rank":3,"intent_id":"I2","query_id":"Q3","rank":3,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015873015873015872,"score":0.015873015873015872,"stale":false}],"intent_relevance":{},"label":"E3","section_id":"2.2","section_title":"Ladder Storage","selected_for":["I2"],"source_path":"Doc_07_fixture_orchard.txt","supporting_intents":["I2"],"supporting_queries":["Q3"],"text":"Ladders are not permitted in the orchard overnight and must be returned to the tool shed.","token_count":16},{"alternates":[],"best_rank_by_intent":{"I2":4},"char_end":656,"char_start":564,"chunk_id":"Doc_07§2.1#1","citation":"Doc_07 §2.1","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§2.1#1","fused_score":0.015625,"hits":[{"bm25_rank":null,"dense_rank":4,"intent_id":"I2","query_id":"Q3","rank":4,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015625,"score":0.015625,