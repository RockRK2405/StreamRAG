e_orchard.txt","supporting_intents":["I1"],"supporting_queries":["Q2"],"text":"A picker may fill at most 40 crates per shift. Damaged fruit is placed in the compost bin, not in the crates. The harvest supervisor checks the crate count at the end of every shift. Crates are stacked no more than five high. Stacks taller than five crates must be split before the cart leaves the row. The cart driver confirms the stack height before moving. Fruit picked after sunset is recorded separately. Late fruit is stored in the cool room until the next morning.","token_count":85}],"per_intent":[{"best_rank":1,"candidates":5,"covered":true,"evidence_ids":["Doc_07§2.1#1","Doc_07§2.2#1","fixture_lighthouse_manual§2#1","Doc_07§4#1","Doc_07§3#1"],"intent_id":"I1","labels":["E1","E2","E3","E4","E5"],"query_id":"Q2","status":"ok"}],"relations":[],"rerank":"none","session_id":"mi-D5","strategy":"intent_aware","token_count":168,"top_k":8,"unified_set_id":"ues-26ce0424e391","utterance_id":"u1","warnings":[]},"wall":{"decompose_ms_total":1.2383,"fusion_timings_ms":{"conflicts":0.0137,"dedup":0.0128,"select":0.0056,"total":0.0746}}},"query_id":null,"schema_version":"1.0","seq":37,"session_id":"mi-D5","t_session_ms":4372.2,"t_stream_s":4.3722,"t_wall_ms":10.074,"type":"TURN_COMPLETED","utterance_id":"u1"}
