e_observatory_notes.txt","supporting_intents":["I2"],"supporting_queries":["Q2"],"text":"TEST FIXTURE ONLY. Synthetic text written for software tests; it is not part of any real corpus.\n\nThe fixture observatory opens its dome only when the wind speed is below 25 kilometres per hour. Observers log the dome status every hour.\n\nThe main telescope is recalibrated on the first night of every month. Calibration takes about ninety minutes and is recorded in the calibration journal.\n\nVisitors are welcome on Fridays. Visitors may not touch the telescope controls.","token_count":77},{"alternates":[],"best_rank_by_intent":{"I2":3,"I3":1},"char_end":288,"char_start":158,"chunk_id":"fixture_lighthouse_manual§1#1","citation":"fixture_lighthouse_manual §1","conflict_ids":[],"document_id":"fixture_lighthouse_manual","evidence_id":"fixture_lighthouse_manual§1#1","fused_score":0.032787,"hits":[{"bm25_rank":null,"dense_rank":3,"intent_id":"I2","query_id":"Q2","rank":3,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.015873015873015872,"score":0.015873015873015872,"stale":false},{"bm25_rank":1,"dense_rank":1,"intent_id":"I3","query_id":"Q3","rank":1,"rerank_score":null,"retrieval_method":"hybrid_rrf","rrf_score":0.03278688524590164,"score":0.03278688524590164,"stale":false}],"intent_relevance":{},"label":"E6","section_id":"1","section_title":"Lamp Maintenance","selected_for":["I3"],"source_path":"fixture_lighthouse_manual.md","supporting_intents":["I2","I3"],"supporting_queries":["Q2","Q3"],"text":"The lamp of the fixture lighthouse must be cleaned every evening before sunset. Keepers record each cleaning in the lamp register.","token_count":21},{"alternates":[],"best_rank_by_intent":{"I1":3,"I3":2},"char_end":1398,"char_start":1276,"chunk_id":"Doc_07§4#1","citation":"Doc_07 §4","conflict_ids":[],"document_id":"Doc_07","evidence_id":"Doc_07§4#1","fused_score":0.031281,"hits":[{"bm25_rank":null,"dense_rank":3,"intent_id":"I1","query_id":"Q1","rank":3,"rerank_score