# StreamRAG environment template. Copy to .env (git-ignored) and adjust. No secrets are needed in Phase 3.

# Location of the OFFICIAL Theme 4 corpus (overrides paths.corpus in configs/default.yaml).
STREAMRAG_CORPUS=./corpus

# Optional: Hugging Face cache location for build-time model download (streamrag fetch-models).
# HF_HOME=./.hf-cache

# Phase 7+ (answer synthesis), not used yet:
# ANTHROPIC_API_KEY=
