# StreamRAG configuration (copy to .env and adjust). Placeholders only - StreamRAG needs NO API keys, tokens or
# passwords: retrieval, embedding and verification run locally and the LLM is a local Ollama model.
#
# Corpus to index: the OFFICIAL Theme 4 corpus when available (default for `streamrag serve`: demo/corpus, the
# fictional demo data; default for the other commands: paths.corpus in configs/default.yaml, ./corpus)
# STREAMRAG_CORPUS=./corpus
# STREAMRAG_INDEX_ROOT=./indexes
# STREAMRAG_MODELS_DIR=./models

# LLM backend: auto (Ollama if reachable, else verified extractive answers) | ollama (required) | extractive (no LLM)
STREAMRAG_LLM_BACKEND=auto
# Ollama endpoint. Must be loopback unless its host is listed in STREAMRAG_ALLOWED_LLM_HOSTS (explicit opt-in).
STREAMRAG_LLM_URL=http://127.0.0.1:11434
STREAMRAG_LLM_MODEL=qwen3:4b
# Extra hosts the LLM may live on (comma separated). Docker compose sidecar: ollama.
# Docker Desktop + Ollama on the host: STREAMRAG_LLM_URL=http://host.docker.internal:11434 and
# STREAMRAG_ALLOWED_LLM_HOSTS=host.docker.internal
STREAMRAG_ALLOWED_LLM_HOSTS=

# Demo server
STREAMRAG_HOST=127.0.0.1
STREAMRAG_PORT=8080
STREAMRAG_LOG_LEVEL=INFO

# Optional: Hugging Face cache location for build-time model download (streamrag fetch-models)
# HF_HOME=./.hf-cache

