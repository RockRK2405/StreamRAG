{
  "$defs": {
    "RetrievalFilters": {
      "additionalProperties": false,
      "properties": {
        "document_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Ids"
        },
        "section_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Ids"
        }
      },
      "title": "RetrievalFilters",
      "type": "object"
    },
    "RetrievalOptions": {
      "additionalProperties": false,
      "description": "Per-call overrides; ``None`` means \"use configs/default.yaml\".",
      "properties": {
        "dedup": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dedup"
        },
        "dense_k": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dense K"
        },
        "filters": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrievalFilters"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lexical_k": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lexical K"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "bm25",
                "dense",
                "hybrid"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "rerank": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank"
        },
        "rerank_k": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank K"
        },
        "rrf_k": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rrf K"
        },
        "top_k": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top K"
        }
      },
      "title": "RetrievalOptions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "options": {
      "$ref": "#/$defs/RetrievalOptions",
      "default": {
        "dedup": null,
        "dense_k": null,
        "filters": null,
        "lexical_k": null,
        "mode": null,
        "rerank": null,
        "rerank_k": null,
        "rrf_k": null,
        "top_k": null
      }
    },
    "query": {
      "title": "Query",
      "type": "string"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    }
  },
  "required": [
    "query"
  ],
  "title": "RetrievalRequest",
  "type": "object"
}
