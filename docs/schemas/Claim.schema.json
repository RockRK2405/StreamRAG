{
  "$defs": {
    "ClaimSource": {
      "additionalProperties": false,
      "description": "Exact origin of an extractive claim: characters [char_start, char_end) of the evidence text.",
      "properties": {
        "char_end": {
          "minimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "char_start",
        "char_end"
      ],
      "title": "ClaimSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "confidence": {
      "default": 0.0,
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "confidence_signals": {
      "additionalProperties": {
        "type": "number"
      },
      "default": {},
      "title": "Confidence Signals",
      "type": "object"
    },
    "created_at_ms": {
      "default": 0.0,
      "minimum": 0,
      "title": "Created At Ms",
      "type": "number"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "frame_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frame Id"
    },
    "intent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intent Id"
    },
    "intent_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intent Version"
    },
    "introduced_by_constraint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Introduced By Constraint"
    },
    "introduced_in": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Introduced In"
    },
    "modified_in": {
      "default": [],
      "items": {
        "type": "integer"
      },
      "title": "Modified In",
      "type": "array"
    },
    "origin": {
      "default": "extractive",
      "enum": [
        "extractive",
        "generated"
      ],
      "title": "Origin",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClaimSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "default": "PENDING_VALIDATION",
      "enum": [
        "PENDING_VALIDATION",
        "SUPPORTED",
        "PARTIALLY_SUPPORTED",
        "UNSUPPORTED",
        "SUPERSEDED",
        "STALE"
      ],
      "title": "Status",
      "type": "string"
    },
    "status_reason": {
      "default": "",
      "title": "Status Reason",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "type": {
      "default": "FACTUAL",
      "enum": [
        "FACTUAL",
        "UNCERTAINTY",
        "CONNECTIVE",
        "CLARIFICATION"
      ],
      "title": "Type",
      "type": "string"
    },
    "updated_at_ms": {
      "default": 0.0,
      "minimum": 0,
      "title": "Updated At Ms",
      "type": "number"
    }
  },
  "required": [
    "claim_id",
    "text"
  ],
  "title": "Claim",
  "type": "object"
}
