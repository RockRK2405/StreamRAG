    "AnswerSection": {
      "additionalProperties": false,
      "description": "One section per active intent of the frame; the unit of (later) partial regeneration.",
      "properties": {
        "claim_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "constraints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
