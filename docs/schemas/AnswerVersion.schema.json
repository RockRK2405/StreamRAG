        "from_status": {
          "anyOf": [
            {
              "enum": [
                "PENDING_VALIDATION",
                "SUPPORTED",
                "PARTIALLY_SUPPORTED",
                "UNSUPPORTED",
                "SUPERSEDED",
                "STALE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Status"
        },
        "from_text": {
          "title": "From Text",
          "type": "string"
        },
        "to_citations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "To Citations",
          "type": "array"
        },
        "to_status": {
          "anyOf": [
            {
              "enum": [
                "PENDING_VALIDATION",
                "SUPPORTED",
                "PARTIALLY_SUPPORTED",
                "UNSUPPORTED",
                "SUPERSEDED",
                "STALE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Status"
        },
        "to_text": {
          "title": "To Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "from_text",
        "to_text"
      ],
      "title": "ClaimChange",
      "type": "object"
    },
    "UncertaintyItem": {
