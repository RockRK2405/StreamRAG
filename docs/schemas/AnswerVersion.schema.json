        "intent_version": {
          "minimum": 1,
          "title": "Intent Version",
          "type": "integer"
        },
        "needs_regeneration": {
          "default": true,
          "title": "Needs Regeneration",
          "type": "boolean"
        },
        "order": {
          "default": 0,
          "minimum": 0,
          "title": "Order",
          "type": "integer"
