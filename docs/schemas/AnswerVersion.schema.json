        "section_id": {
          "title": "Section Id",
          "type": "string"
        },
        "status": {
          "default": "new",
          "enum": [
            "new",
            "unchanged",
            "changed"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "uncertainty": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UncertaintyItem"
          },
          "title": "Uncertainty",
          "type": "array"
        }
      },
      "required": [
        "section_id",
        "intent_id",
        "intent_version",
        "title"
      ],
      "title": "AnswerSection",
      "type": "object"
    },
    "ClaimChange": {
      "additionalProperties": false,
