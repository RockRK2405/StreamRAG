        "kind": {
          "enum": [
            "no_evidence",
            "conflict",
            "unverified_claim",
            "ambiguous",
            "constraint_not_covered"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "aspect"
      ],
      "title": "UncertaintyItem",
      "type": "object"
